{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyORf4X3NpAAt+mWXnvrEO/T"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"79zAwZSzRXBl"},"outputs":[],"source":["#Note: This should be run as a Jupyter notebook, and has been condensed into a Python file for simplicity. Cell boundaries have been indicated.\n","\n","# %% [markdown]\n","# # Setup: Imports & Config\n","\n","# %%\n","import os\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","DATA_DIR = \"/mnt/beegfs/scoulombe\"\n","BIN_NAMES = [\"0\", \"1\", \"2\"]\n","\n","SNAPSHOT_TAG = \"binned_finegrained_v2_bigmodel_n64_v1\"          # original curriculum run's tag\n","FINETUNE_SNAPSHOT_TAG = \"binned_finetune_flamingo_rot_v1\"       # fine-tuning run's tag\n","\n","# %% [markdown]\n","# ## Job key builders (QE / ViT expected keys)\n","\n","# %%\n","# ---- one entry per job: (label, path, expected_keys) ----\n","\n","def qe_keys(bin_names, eps_list, include_nl=True):\n","    keys = []\n","    for b in bin_names:\n","        for eps in eps_list:\n","            keys += [\n","                f\"cl_true_bin{b}_eps{eps}\",\n","                f\"cl_qe_bin{b}_eps{eps}\",\n","                f\"cl_cross_bin{b}_eps{eps}\",\n","                f\"mse_bin{b}_eps{eps}\",\n","                f\"v_hat_bin{b}_eps{eps}\",\n","            ]\n","            if include_nl:\n","                keys.append(f\"Nl_bin{b}_eps{eps}\")\n","    return keys\n","\n","def vit_keys(bin_names, eps_list):\n","    keys = []\n","    for b in bin_names:\n","        keys.append(f\"cl_true_bin{b}\")  # saved once per bin, not per eps, in the ViT scripts\n","        for eps in eps_list:\n","            keys += [\n","                f\"cl_vit_bin{b}_eps{eps}\",\n","                f\"cl_cross_bin{b}_eps{eps}\",\n","                f\"mse_bin{b}_eps{eps}\",\n","                f\"r2_bin{b}_eps{eps}\",\n","                f\"v_hat_bin{b}_eps{eps}\",\n","            ]\n","    for eps in eps_list:\n","        keys += [\n","            f\"loss_total_eps{eps}\",\n","            f\"loss_pixel_raw_eps{eps}\",\n","            f\"loss_patch_raw_eps{eps}\",\n","            f\"loss_spectral_raw_eps{eps}\",\n","            f\"loss_pixel_weighted_eps{eps}\",\n","            f\"loss_patch_weighted_eps{eps}\",\n","            f\"loss_spectral_weighted_eps{eps}\",\n","        ]\n","    return keys\n","\n","# %% [markdown]\n","# ## Job definitions (raw result files)\n","\n","# %%\n","JOBS = [\n","    (\n","        \"QE generated (l=10-5000)\",\n","        os.path.join(DATA_DIR, \"final_qe_generated\", \"qe_binned_results_l10-5000.npz\"),\n","        qe_keys(BIN_NAMES, [0.0, 1.0]),\n","    ),\n","    (\n","        \"QE flamingo (l=10-5000)\",\n","        os.path.join(DATA_DIR, \"final_qe_flamingo\", \"qe_binned_results_l10-5000_flamingo.npz\"),\n","        qe_keys(BIN_NAMES, [0.0, 1.0]),\n","    ),\n","    (\n","        \"QE nosignal (l=10-5000, eps=1.0 only)\",\n","        os.path.join(DATA_DIR, \"final_qe_nosignal\", \"qe_binned_results_l10-5000_nosignal.npz\"),\n","        qe_keys(BIN_NAMES, [1.0]),\n","    ),\n","    (\n","        \"ViT base/generated (stage 24)\",\n","        os.path.join(DATA_DIR, \"final_vit_base_generated\", f\"vit_results_base_generated_stage24_{SNAPSHOT_TAG}.npz\"),\n","        vit_keys(BIN_NAMES, [0.0, 1.0]),\n","    ),\n","    (\n","        \"ViT base/flamingo (stage 24)\",\n","        os.path.join(DATA_DIR, \"final_vit_base_flamingo\", f\"vit_results_base_flamingo_stage24_{SNAPSHOT_TAG}.npz\"),\n","        vit_keys(BIN_NAMES, [0.0, 1.0]),\n","    ),\n","    (\n","        \"ViT fine-tuned/flamingo (best checkpoint)\",\n","        os.path.join(DATA_DIR, \"final_vit_fine_flamingo\", f\"vit_results_finetuned_flamingo_{FINETUNE_SNAPSHOT_TAG}.npz\"),\n","        vit_keys(BIN_NAMES, [0.0, 1.0]),\n","    ),\n","]\n","\n","# %% [markdown]\n","# # Power spectrum ($C_\\ell$) analysis\n","# ## $C_\\ell$ job definitions\n","\n","# %%\n","NSIDE = 2048\n","LMAX = 3*2048-1\n","\n","ell = np.arange(LMAX+1)\n","\n","CL_JOBS = [\n","    (\"QE generated\",            os.path.join(DATA_DIR, \"final_qe_generated\",  \"qe_binned_results_l10-5000.npz\"),\n","     \"cl_qe\",  True,  [0.0, 1.0]),\n","    (\"QE flamingo\",             os.path.join(DATA_DIR, \"final_qe_flamingo\",   \"qe_binned_results_l10-5000_flamingo.npz\"),\n","     \"cl_qe\",  True,  [0.0, 1.0]),\n","    (\"QE nosignal\",             os.path.join(DATA_DIR, \"final_qe_nosignal\",   \"qe_binned_results_l10-5000_nosignal.npz\"),\n","     \"cl_qe\",  True,  [1.0]),\n","    (\"ViT base/generated\",      os.path.join(DATA_DIR, \"final_vit_base_generated\", f\"vit_results_base_generated_stage24_{SNAPSHOT_TAG}.npz\"),\n","     \"cl_vit\", False, [0.0, 1.0]),\n","    (\"ViT base/flamingo\",       os.path.join(DATA_DIR, \"final_vit_base_flamingo\",  f\"vit_results_base_flamingo_stage24_{SNAPSHOT_TAG}.npz\"),\n","     \"cl_vit\", False, [0.0, 1.0]),\n","    (\"ViT fine-tuned/flamingo\", os.path.join(DATA_DIR, \"final_vit_fine_flamingo\",  f\"vit_results_finetuned_flamingo_{FINETUNE_SNAPSHOT_TAG}.npz\"),\n","     \"cl_vit\", False, [0.0, 1.0]),\n","]\n","\n","# %% [markdown]\n","# ## Load $C_\\ell$ data from files\n","\n","# %%\n","cl_true_dict = {}\n","cl_pred_dict = {}\n","cl_cross_dict = {}\n","\n","for label, path, pred_key_prefix, is_qe, eps_list in CL_JOBS:\n","    cl_true_dict[label] = {}\n","    cl_pred_dict[label] = {}\n","    cl_cross_dict[label] = {}\n","    with np.load(path) as d:\n","        for b in BIN_NAMES:\n","            cl_true_dict[label][b] = {}\n","            cl_pred_dict[label][b] = {}\n","            cl_cross_dict[label][b] = {}\n","            for eps in eps_list:\n","                if is_qe:\n","                    cl_true_dict[label][b][eps] = d[f\"cl_true_bin{b}_eps{eps}\"]\n","                else:\n","                    cl_true_dict[label][b][eps] = d[f\"cl_true_bin{b}\"]\n","                cl_pred_dict[label][b][eps] = d[f\"{pred_key_prefix}_bin{b}_eps{eps}\"]\n","                cl_cross_dict[label][b][eps] = d[f\"cl_cross_bin{b}_eps{eps}\"]\n","\n","# %% [markdown]\n","# ## Bin the $C_\\ell$ curves\n","\n","# %%\n","BIN_WIDTH = 5  # ells 1-5, 6-10, 11-15, ...\n","\n","def bin_cl_weighted(ell_in, cl_in, bin_edges, weights):\n","    binned = np.full(len(bin_edges) - 1, np.nan)\n","    for i in range(len(bin_edges) - 1):\n","        mask = (ell_in >= bin_edges[i]) & (ell_in < bin_edges[i + 1])\n","        if mask.sum() == 0:\n","            continue\n","        w = weights[mask]\n","        binned[i] = np.sum(w * cl_in[mask]) / np.sum(w)\n","    return binned\n","\n","ell_min = 1\n","ell_max = ell.max()\n","n_bins = int(np.ceil((ell_max - ell_min + 1) / BIN_WIDTH))\n","bin_edges = ell_min + BIN_WIDTH * np.arange(n_bins + 1)\n","bin_centers = 0.5 * (bin_edges[:-1] + bin_edges[1:] - 1)\n","\n","weights = 2 * ell + 1  # (2l+1), matching the equation\n","\n","# %% [markdown]\n","# ## Apply binning\n","\n","# %%\n","for label, path, pred_key_prefix, is_qe, eps_list in CL_JOBS:\n","    for b in BIN_NAMES:\n","        for eps in eps_list:\n","            cl_true_dict[label][b][eps] = bin_cl_weighted(ell, cl_true_dict[label][b][eps], bin_edges, weights)\n","            cl_pred_dict[label][b][eps] = bin_cl_weighted(ell, cl_pred_dict[label][b][eps], bin_edges, weights)\n","            cl_cross_dict[label][b][eps] = bin_cl_weighted(ell, cl_cross_dict[label][b][eps], bin_edges, weights)\n","\n","ell = bin_centers\n","\n","print(bin_edges)\n","\n","# %% [markdown]\n","# ## Compute $r_\\ell$ (cross-correlation coefficient)\n","\n","# %%\n","r2_dict = {}\n","\n","for label, path, pred_key_prefix, is_qe, eps_list in CL_JOBS:\n","    r2_dict[label] = {}\n","    for b in BIN_NAMES:\n","        r2_dict[label][b] = {}\n","        for eps in eps_list:\n","            cl_true = cl_true_dict[label][b][eps]\n","            cl_pred = cl_pred_dict[label][b][eps]\n","            cl_cross = cl_cross_dict[label][b][eps]\n","            r2_dict[label][b][eps] = cl_cross / np.sqrt(cl_true * cl_pred)\n","\n","sum_weights_per_bin = bin_edges[1:]**2 - bin_edges[:-1]**2  # sum_{l in bin} (2l+1), closed form\n","# print(sum_weights_per_bin)\n","\n","# %% [markdown]\n","# ## Plot: $r_\\ell$ for generated data (QE vs ViT, eps=0 and 1)\n","\n","# %%\n","for b in BIN_NAMES:\n","    fig, ax = plt.subplots(figsize=(9, 6))\n","    for eps in [0.0, 1.0]:\n","        if (eps == 1.0):\n","            cmb = \"CMB\"\n","        else:\n","            cmb = \"no CMB\"\n","        r2_qe = r2_dict[\"QE generated\"][b][eps]\n","        err_qe = (1 - r2_qe**2) / np.sqrt(sum_weights_per_bin)\n","        qe_color = \"darkorange\" if eps == 0.0 else \"tab:red\"\n","        line_qe, = ax.plot(ell, r2_qe, label=f\"QE {cmb}\", color=qe_color)\n","        ax.fill_between(ell, r2_qe - err_qe, r2_qe + err_qe, color=line_qe.get_color(), alpha=0.2)\n","\n","        r2_vit = r2_dict[\"ViT base/generated\"][b][eps]\n","        err_vit = (1 - r2_vit**2) / np.sqrt(sum_weights_per_bin)\n","        vit_color = \"indigo\" if eps == 0.0 else \"tab:blue\"\n","        line_vit, = ax.plot(ell, r2_vit, label=f\"ViT {cmb}\", color=vit_color)\n","        ax.fill_between(ell, r2_vit - err_vit, r2_vit + err_vit, color=line_vit.get_color(), alpha=0.2)\n","\n","    ax.set_xscale('log')\n","    # ax.set_yscale('log')\n","    ax.set_xlabel(r\"$\\ell$\")\n","    ax.set_ylabel(r\"$r_{\\ell}$\")\n","    ax.axhline(y=1, color=\"grey\", linestyle=\"--\")\n","    ax.set_ylim(0, 1.05)\n","    ax.legend()\n","    plt.tight_layout()\n","    plt.show()\n","\n","# %% [markdown]\n","# ## Plot: $r_\\ell$ for flamingo data, eps=0.0\n","\n","# %%\n","for b in BIN_NAMES:\n","    fig, ax = plt.subplots(figsize=(9, 6))\n","\n","    r2_qe = -r2_dict[\"QE flamingo\"][b][0.0]\n","    err_qe = (1 - r2_qe**2) / np.sqrt(sum_weights_per_bin)\n","    line_qe, = ax.plot(ell, r2_qe, label=\"QE\", color = \"tab:red\")\n","    ax.fill_between(ell, r2_qe - err_qe, r2_qe + err_qe, color=line_qe.get_color(), alpha=0.2)\n","\n","    r2_base = -r2_dict[\"ViT base/flamingo\"][b][0.0]\n","    err_base = (1 - r2_base**2) / np.sqrt(sum_weights_per_bin)\n","    line_base, = ax.plot(ell, r2_base, label=\"ViT Base\", color = \"tab:blue\")\n","    ax.fill_between(ell, r2_base - err_base, r2_base + err_base, color=line_base.get_color(), alpha=0.2)\n","\n","    r2_fine = r2_dict[\"ViT fine-tuned/flamingo\"][b][0.0]\n","    err_fine = (1 - r2_fine**2) / np.sqrt(sum_weights_per_bin)\n","    line_fine, = ax.plot(ell, r2_fine, label=\"ViT Finetuned\", color = \"indigo\")\n","    ax.fill_between(ell, r2_fine - err_fine, r2_fine + err_fine, color=line_fine.get_color(), alpha=0.2)\n","\n","    ax.set_xscale('log')\n","    # ax.set_yscale('log')\n","    ax.set_xlabel(r\"$\\ell$\")\n","    ax.set_ylabel(r\"$r_{\\ell}$\")\n","    ax.axhline(y=1, color=\"grey\", linestyle=\"--\")\n","    ax.axhline(y=0, color=\"grey\", linestyle=\"--\")\n","    ax.set_ylim(-0.7, 1.05)\n","    ax.legend()\n","    plt.tight_layout()\n","    plt.show()\n","\n","# %% [markdown]\n","# ## Plot: $r_\\ell$ for flamingo data, eps=1.0\n","\n","# %%\n","for b in BIN_NAMES:\n","    fig, ax = plt.subplots(figsize=(9, 6))\n","\n","    r2_qe = -r2_dict[\"QE flamingo\"][b][1.0]\n","    err_qe = (1 - r2_qe**2) / np.sqrt(sum_weights_per_bin)\n","    line_qe, = ax.plot(ell, r2_qe, label=\"QE\", color = \"tab:red\")\n","    ax.fill_between(ell, r2_qe - err_qe, r2_qe + err_qe, color=line_qe.get_color(), alpha=0.2)\n","\n","    r2_base = -r2_dict[\"ViT base/flamingo\"][b][1.0]\n","    err_base = (1 - r2_base**2) / np.sqrt(sum_weights_per_bin)\n","    line_base, = ax.plot(ell, r2_base, label=\"ViT Base\", color = \"tab:blue\")\n","    ax.fill_between(ell, r2_base - err_base, r2_base + err_base, color=line_base.get_color(), alpha=0.2)\n","\n","    r2_fine = r2_dict[\"ViT fine-tuned/flamingo\"][b][1.0]\n","    err_fine = (1 - r2_fine**2) / np.sqrt(sum_weights_per_bin)\n","    line_fine, = ax.plot(ell, r2_fine, label=\"ViT Finetuned\", color = \"indigo\")\n","    ax.fill_between(ell, r2_fine - err_fine, r2_fine + err_fine, color=line_fine.get_color(), alpha=0.2)\n","\n","    ax.set_xscale('log')\n","    # ax.set_yscale('log')\n","    ax.set_xlabel(r\"$\\ell$\")\n","    ax.set_ylabel(r\"$r_{\\ell}$\")\n","    ax.axhline(y=1, color=\"grey\", linestyle=\"--\")\n","    ax.axhline(y=0, color=\"grey\", linestyle=\"--\")\n","    ax.set_ylim(-0.7, 1.05)\n","    ax.legend()\n","    plt.tight_layout()\n","    plt.show()\n","\n","# %% [markdown]\n","# # Mollweide + patch maps\n","# ## Imports & config\n","\n","# %%\n","import healpy as hp\n","import matplotlib.pyplot as plt\n","import matplotlib.colorbar as mcolorbar\n","from matplotlib.colors import Normalize\n","\n","DATA_DIR = \"/mnt/beegfs/scoulombe\"\n","BIN_NAMES = [\"0\", \"1\", \"2\"]\n","NSIDE_MAP = 2048\n","NSIDE_PATCH = 256\n","\n","SMOOTHED_FILE = os.path.join(DATA_DIR, \"final_mollweide_smoothed\", \"smoothed_maps_fwhm1deg.npz\")\n","\n","MOLLWEIDE_JOBS = {\n","    \"generated\": [\n","        (\"QE generated\",       None),\n","        (\"ViT base/generated\", None),\n","    ],\n","    \"flamingo\": [\n","        (\"QE flamingo\",             None),\n","        (\"ViT base/flamingo\",       None),\n","        (\"ViT fine-tuned/flamingo\", None),\n","    ],\n","}\n","\n","EPS_LIST = [0.0, 1.0]\n","TITLE_MAP = {\n","    \"QE generated\": \"QE\",\n","    \"ViT base/generated\": \"ViT\",\n","    \"QE flamingo\": \"QE\",\n","    \"ViT base/flamingo\": \"ViT Base\",\n","    \"ViT fine-tuned/flamingo\": \"ViT Finegrain\",\n","}\n","PATCH_FACE, PATCH_ROW, PATCH_COL = 0, 0, 0\n","\n","# %% [markdown]\n","# ## Layout constants (inches)\n","\n","# %%\n","COL_WIDTH_IN     = 4.2   # width of each column (mollweide + patch share this)\n","MOLL_ASPECT      = 0.5   # mollweide height/width ratio (2:1 projection)\n","TITLE_PAD_IN     = 0.4   # extra room above the ellipse for the title\n","GAP_IN           = 0.35  # vertical gap between mollweide and patch\n","CBAR_PAD_IN      = 0.15  # gap between patch and its colorbar\n","CBAR_HEIGHT_IN   = 0.2\n","TOP_MARGIN_IN    = 0.5   # room for suptitle\n","BOTTOM_MARGIN_IN = 0.25\n","COL_GAP_IN       = 0.35  # horizontal gap between columns\n","SIDE_MARGIN_IN   = 0.3\n","\n","MOLL_HEIGHT_IN  = COL_WIDTH_IN * MOLL_ASPECT + TITLE_PAD_IN\n","PATCH_HEIGHT_IN = COL_WIDTH_IN  # patch is square (NSIDE_PATCH x NSIDE_PATCH)\n","\n","# %% [markdown]\n","# ## Helper functions\n","\n","# %%\n","def _safe(label):\n","    return label.replace(\" \", \"_\").replace(\"/\", \"_\")\n","\n","def precompute_face_indices(nside):\n","    npix = hp.nside2npix(nside)\n","    ipix = np.arange(npix, dtype=np.int32)\n","    x, y, f = hp.pix2xyf(nside, ipix, nest=True)\n","    face_idx = {}\n","    for face_id in range(12):\n","        mask = f == face_id\n","        face_idx[face_id] = (ipix[mask].astype(np.int32), x[mask].astype(np.int32), y[mask].astype(np.int32))\n","    return face_idx\n","\n","def get_face_2d(map_nest, nside, face_id, face_idx):\n","    ipix_f, x_f, y_f = face_idx[face_id]\n","    face_img = np.full((nside, nside), np.nan, dtype=map_nest.dtype)\n","    face_img[y_f, x_f] = map_nest[ipix_f]\n","    return face_img\n","\n","def extract_patch(map_ring, face_id=PATCH_FACE, row=PATCH_ROW, col=PATCH_COL):\n","    map_nest = hp.reorder(map_ring, r2n=True)\n","    face_img = get_face_2d(map_nest, NSIDE_MAP, face_id, FACE_IDX)\n","    return face_img[row*NSIDE_PATCH:(row+1)*NSIDE_PATCH, col*NSIDE_PATCH:(col+1)*NSIDE_PATCH]\n","\n","def make_patch_mask(nside_map, face_id, row, col, nside_patch, face_idx):\n","    npix = hp.nside2npix(nside_map)\n","    mask = np.zeros(npix, dtype=bool)\n","    ipix_f, x_f, y_f = face_idx[face_id]\n","    row_mask = (y_f >= row * nside_patch) & (y_f < (row + 1) * nside_patch)\n","    col_mask = (x_f >= col * nside_patch) & (x_f < (col + 1) * nside_patch)\n","    patch_mask = row_mask & col_mask\n","    mask[ipix_f[patch_mask]] = True\n","    return mask\n","\n","def with_patch_highlighted(map_ring, patch_mask_nest):\n","    map_nest = hp.reorder(map_ring, r2n=True).copy()\n","    map_nest[patch_mask_nest] = np.nan\n","    return hp.reorder(map_nest, n2r=True)\n","\n","def add_col_axes(fig, fig_w_in, fig_h_in, col):\n","    \"\"\"Create (mollweide, patch, colorbar) axes for one column at exact inch positions.\"\"\"\n","    x0_in = SIDE_MARGIN_IN + col * (COL_WIDTH_IN + COL_GAP_IN)\n","\n","    moll_y1_in = fig_h_in - TOP_MARGIN_IN\n","    moll_y0_in = moll_y1_in - MOLL_HEIGHT_IN\n","    patch_y1_in = moll_y0_in - GAP_IN\n","    patch_y0_in = patch_y1_in - PATCH_HEIGHT_IN\n","    cbar_y1_in = patch_y0_in - CBAR_PAD_IN\n","    cbar_y0_in = cbar_y1_in - CBAR_HEIGHT_IN\n","\n","    def to_frac(x_in, y_in, w_in, h_in):\n","        return [x_in / fig_w_in, y_in / fig_h_in, w_in / fig_w_in, h_in / fig_h_in]\n","\n","    moll_ax  = fig.add_axes(to_frac(x0_in, moll_y0_in, COL_WIDTH_IN, MOLL_HEIGHT_IN))\n","    patch_ax = fig.add_axes(to_frac(x0_in, patch_y0_in, COL_WIDTH_IN, PATCH_HEIGHT_IN))\n","    cbar_ax  = fig.add_axes(to_frac(x0_in, cbar_y0_in, COL_WIDTH_IN, CBAR_HEIGHT_IN))\n","    return moll_ax, patch_ax, cbar_ax\n","\n","def plot_mollweide(moll_ax, data, title, vmax, cmap):\n","    \"\"\"Draw into moll_ax, restoring its exact position afterward (mollview repositions\n","    axes internally on call).\"\"\"\n","    pos = moll_ax.get_position()\n","    plt.axes(moll_ax)\n","    hp.mollview(data, hold=True, title=title, min=-vmax, max=vmax, cmap=cmap,\n","                badcolor=\"grey\", cbar=False)\n","    moll_ax.set_position(pos)\n","\n","# %% [markdown]\n","# ## Precompute face indices & patch mask\n","\n","# %%\n","FACE_IDX = precompute_face_indices(NSIDE_MAP)\n","PATCH_MASK_NEST = make_patch_mask(NSIDE_MAP, PATCH_FACE, PATCH_ROW, PATCH_COL, NSIDE_PATCH, FACE_IDX)\n","\n","# %% [markdown]\n","# ## Main plotting loop: data_source -> bin -> eps\n","\n","# %%\n","with np.load(SMOOTHED_FILE) as d:\n","    for data_source, jobs in MOLLWEIDE_JOBS.items():\n","        for b in BIN_NAMES:\n","            v_true_smooth = hp.remove_monopole(d[f\"true_smooth_{data_source}_bin{b}\"])\n","            true_patch = extract_patch(v_true_smooth)\n","\n","            for eps in EPS_LIST:\n","                n_cols = 1 + len(jobs)\n","                vmax = np.nanpercentile(np.abs(v_true_smooth), 99)\n","\n","                fig_w_in = 2 * SIDE_MARGIN_IN + n_cols * COL_WIDTH_IN + (n_cols - 1) * COL_GAP_IN\n","                fig_h_in = (TOP_MARGIN_IN + MOLL_HEIGHT_IN + GAP_IN + PATCH_HEIGHT_IN\n","                            + CBAR_PAD_IN + CBAR_HEIGHT_IN + BOTTOM_MARGIN_IN)\n","                fig = plt.figure(figsize=(fig_w_in, fig_h_in))\n","\n","                # --- column 0: True ---\n","                moll_ax, patch_ax, cbar_ax = add_col_axes(fig, fig_w_in, fig_h_in, 0)\n","                plot_mollweide(moll_ax, with_patch_highlighted(v_true_smooth, PATCH_MASK_NEST),\n","                                \"True\", vmax, \"PRGn_r\")\n","\n","                patch_ax.imshow(true_patch, cmap=\"PRGn_r\", vmin=-vmax, vmax=vmax, interpolation=\"nearest\")\n","                patch_ax.set_xticks([]); patch_ax.set_yticks([])\n","\n","                norm = Normalize(vmin=-vmax, vmax=vmax)\n","                mcolorbar.ColorbarBase(cbar_ax, cmap=\"PRGn_r\", norm=norm,\n","                                        orientation=\"horizontal\").ax.tick_params(labelsize=8)\n","\n","                # --- remaining columns: reconstructions ---\n","                for i, (label, _) in enumerate(jobs):\n","                    key = f\"vhat_smooth_{data_source}_bin{b}_eps{eps}_{_safe(label)}\"\n","                    v_hat_smooth = hp.remove_monopole(d[key])\n","                    v_hat_patch = extract_patch(v_hat_smooth)\n","\n","                    recon_cmap = \"PRGn\" if (data_source == \"flamingo\" and label in (\"QE flamingo\", \"ViT base/flamingo\")) else \"PRGn_r\"\n","\n","                    moll_ax, patch_ax, cbar_ax = add_col_axes(fig, fig_w_in, fig_h_in, i + 1)\n","                    plot_mollweide(moll_ax, with_patch_highlighted(v_hat_smooth, PATCH_MASK_NEST),\n","                                    TITLE_MAP.get(label, label), vmax, recon_cmap)\n","\n","                    patch_ax.imshow(v_hat_patch, cmap=recon_cmap, vmin=-vmax, vmax=vmax, interpolation=\"nearest\")\n","                    patch_ax.set_xticks([]); patch_ax.set_yticks([])\n","\n","                    norm = Normalize(vmin=-vmax, vmax=vmax)\n","                    mcolorbar.ColorbarBase(cbar_ax, cmap=recon_cmap, norm=norm,\n","                                            orientation=\"horizontal\").ax.tick_params(labelsize=8)\n","\n","                fig.suptitle(f\"{data_source} data, bin {b}, eps={eps}\", y=1 - (TOP_MARGIN_IN * 0.4 / fig_h_in))\n","                plt.show()"]},{"cell_type":"code","source":[],"metadata":{"id":"ozad3kY6RZUc"},"execution_count":null,"outputs":[]}]}